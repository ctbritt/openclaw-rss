{
  "name": "@ctbritt/openclaw-rss",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && openclaw plugins build",
    "validate": "openclaw plugins validate --json",
    "pack": "openclaw plugins pack --json",
    "compile": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test --no-warnings test/"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "assets/icon.png",
    "LICENSE"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.11.5-beta.3"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "fast-xml-parser": "^5.12.1",
    "linkedom": "^0.18.15",
    "sanitize-html": "^2.18.2",
    "typebox": "^1.3.17"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/sanitize-html": "^2.16.2",
    "esbuild": "0.28.2",
    "openclaw": "^2026.11.5-beta.3",
    "typescript": "7.0.2"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "controlUi": "./src/control-ui.ts",
    "compat": {
      "pluginApi": ">=2026.11.5-beta.3"
    },
    "build": {
      "openclawVersion": "2026.11.5-beta.3"
    }
  },
  "description": "A native OpenClaw RSS and Atom reader with full-text articles, search, and optional AI importance grading.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ctbritt/openclaw-rss.git"
  },
  "homepage": "https://github.com/ctbritt/openclaw-rss#readme",
  "bugs": {
    "url": "https://github.com/ctbritt/openclaw-rss/issues"
  },
  "keywords": [
    "openclaw",
    "rss",
    "atom",
    "reader",
    "news"
  ],
  "license": "MIT",
  "author": "ctbritt"
}
